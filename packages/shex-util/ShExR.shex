PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
BASE <http://www.w3.org/ns/shex>
start=@<#Schema>

<#Schema> CLOSED {
  a [sx:Schema] ;
  sx:imports LIST + IRI ? ;
  sx:startActs LIST + @<#SemAct> ? ;
  sx:start @<#shapeDeclOrExpr> ? ;
  sx:shapes LIST + @<#ShapeDecl> ?
}

<#shapeDeclOrExpr> @<#ShapeDecl> OR @<#shapeExpr>

<#ShapeDecl> CLOSED {
  a [sx:ShapeDecl] ;
  sx:abstract [true false] ? ;
  sx:shapeExpr @<#shapeExpr>
}

<#shapeExpr> @<#ShapeOr> OR @<#ShapeAnd> OR @<#ShapeNot> OR @<#NodeConstraint> OR @<#Shape> OR @<#ShapeExternal> OR @<#ListShape>

<#ShapeOr> CLOSED {
  a [sx:ShapeOr] ;
  sx:shapeExprs LIST {2,} @<#shapeDeclOrExpr>
}

<#ShapeAnd> CLOSED {
  a [sx:ShapeAnd] ;
  sx:shapeExprs LIST {2,} @<#shapeDeclOrExpr>
}

<#ShapeNot> CLOSED {
  a [sx:ShapeNot] ;
  sx:shapeExpr @<#shapeDeclOrExpr>
}

# rdf-array: the LIST shape expression, LIST ( regex ) over the members of a sequence or LIST card x. Its
# expression is a Member (min..max consecutive members, each matching shapeExpr; max -1: unbounded), an Undef
# (min..max empty slots) or an
# ordered ListEachOf or ListOneOf of list expressions, with min and max as on triple expressions.
<#ListShape> CLOSED {
  a [sx:ListShape] ;
  sx:expression @<#listExpr>
}

<#listExpr> @<#Member> OR @<#Undef> OR @<#ListEachOf> OR @<#ListOneOf>

<#Member> CLOSED {
  a [sx:Member] ;
  sx:shapeExpr @<#shapeDeclOrExpr> ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ?
}

<#Undef> CLOSED {
  a [sx:Undef] ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ?
}

<#ListEachOf> CLOSED {
  a [sx:ListEachOf] ;
  sx:expressions LIST + @<#listExpr> ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ?
}

<#ListOneOf> CLOSED {
  a [sx:ListOneOf] ;
  sx:expressions LIST {2,} @<#listExpr> ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ?
}

<#NodeConstraint> CLOSED {
  a [sx:NodeConstraint] ;
  sx:nodeKind [sx:iri sx:bnode sx:literal sx:nonliteral] ? ;
  sx:datatype IRI ? ;
  &<#xsFacets> ;
  sx:values LIST + @<#valueSetValue> ? ;
  sx:semActs LIST + @<#SemAct> ? ;
  sx:annotation LIST + @<#Annotation> ?
}

<#Shape> CLOSED {
  a [sx:Shape] ;
  sx:extends LIST + @<#shapeDeclOrExpr> ? ;
  sx:closed [true false] ? ;
  sx:extra IRI * ;
  sx:expression @<#tripleExpression> ? ;
  sx:semActs LIST + @<#SemAct> ? ;
  sx:annotation LIST + @<#Annotation> ?
}

<#ShapeExternal> CLOSED {
  a [sx:ShapeExternal]
}

<#SemAct> CLOSED {
  a [sx:SemAct] ;
  sx:name IRI ;
  sx:code xsd:string ?
}

<#Annotation> CLOSED {
  a [sx:Annotation] ;
  sx:predicate IRI ;
  sx:object @<#objectValue>
}

<#facet_holder> { # hold labeled productions
  $<#xsFacets> ( &<#stringFacet> | &<#numericFacet> ) * ;
  $<#stringFacet> (
      sx:length xsd:integer
    | sx:minlength xsd:integer
    | sx:maxlength xsd:integer
    | sx:pattern xsd:string ; sx:flags xsd:string ?
  ) ;
  $<#numericFacet> (
      sx:mininclusive   @<#numericLiteral>
    | sx:minexclusive   @<#numericLiteral>
    | sx:maxinclusive   @<#numericLiteral>
    | sx:maxexclusive   @<#numericLiteral>
    | sx:totaldigits    xsd:integer
    | sx:fractiondigits xsd:integer
  )
}
<#numericLiteral> xsd:integer OR xsd:decimal OR xsd:double

<#valueSetValue> @<#objectValue> OR @<#IriStem> OR @<#IriStemRange>
                               OR @<#LiteralStem> OR @<#LiteralStemRange>
                OR @<#Language> OR @<#LanguageStem> OR @<#LanguageStemRange>
<#objectValue> IRI OR LITERAL OR LIST * @<#objectValue> # rdf:langString breaks on Annotation.object # rdf-array: or a sequence of them

<#IriStem> CLOSED { a [sx:IriStem] ; sx:stem xsd:string }
<#IriStemRange> CLOSED {
  a [sx:IriStemRange] ;
  sx:stem xsd:string OR @<#Wildcard> ;
  sx:exclusion LIST + ( IRI OR @<#IriStem> )
}

<#LiteralStem> CLOSED { a [sx:LiteralStem] ; sx:stem xsd:string }
<#LiteralStemRange> CLOSED {
  a [sx:LiteralStemRange] ;
  sx:stem xsd:string OR @<#Wildcard> ;
  sx:exclusion LIST + ( xsd:string OR @<#LiteralStem> )
}

<#Language> CLOSED { a [sx:Language] ; sx:languageTag xsd:string }
<#LanguageStem> CLOSED { a [sx:LanguageStem] ; sx:stem xsd:string }
<#LanguageStemRange> CLOSED {
  a [sx:LanguageStemRange] ;
  sx:stem xsd:string OR @<#Wildcard> ;
  sx:exclusion LIST + ( xsd:string OR @<#LanguageStem> )
}

<#Wildcard> BNODE CLOSED {
  a [sx:Wildcard]
}

<#tripleExpression>
     @<#NotYetResolvedInclusion>
  OR @<#TripleConstraint>
  OR @<#OneOf>
  OR @<#EachOf>

<#NotYetResolvedInclusion> CLOSED {} # will have 1 incoming, 0 outgoing arcs

<#OneOf> CLOSED {
  a [sx:OneOf] ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ? ;
  sx:expressions LIST {2,} @<#tripleExpression> ;
  sx:semActs LIST + @<#SemAct> ? ;
  sx:annotation LIST + @<#Annotation> ?
}

<#EachOf> CLOSED {
  a [sx:EachOf] ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ? ;
  sx:expressions LIST {2,} @<#tripleExpression> ;
  sx:semActs LIST + @<#SemAct> ? ;
  sx:annotation LIST + @<#Annotation> ?
}

<#TripleConstraint> CLOSED {
  a [sx:TripleConstraint] ;
  sx:inverse [true false] ? ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ? ;
  sx:predicate IRI ;
  sx:valueExpr @<#shapeDeclOrExpr> ? ;
  sx:semActs LIST + @<#SemAct> ? ;
  sx:annotation LIST + @<#Annotation> ?
}

# rdf-array: there are no RDF lists.  A list written `( ... )` is one sequence term,
# matched above by the LIST shape expressions `LIST + @<#X>` in place of the
# ListNPlus ladder shapes of shexTest's ShExR.shex.
