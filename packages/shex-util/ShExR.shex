PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
BASE <http://www.w3.org/ns/shex>
start=@<#Schema>

<#Schema> CLOSED {
  a [sx:Schema] ;
  sx:imports ((IRI))[1, *] ? ;
  sx:startActs ((@<#SemAct>))[1, *] ? ;
  sx:start @<#shapeDeclOrExpr> ? ;
  sx:shapes ((@<#ShapeDecl>))[1, *] ?
}

<#shapeDeclOrExpr> @<#ShapeDecl> OR @<#shapeExpr>

<#ShapeDecl> CLOSED {
  a [sx:ShapeDecl] ;
  sx:abstract [true false] ? ;
  sx:shapeExpr @<#shapeExpr>
}

<#shapeExpr> @<#ShapeOr> OR @<#ShapeAnd> OR @<#ShapeNot> OR @<#NodeConstraint> OR @<#Shape> OR @<#ShapeExternal> OR @<#Collection>

<#ShapeOr> CLOSED {
  a [sx:ShapeOr] ;
  sx:shapeExprs ((@<#shapeDeclOrExpr>))[2, *]
}

<#ShapeAnd> CLOSED {
  a [sx:ShapeAnd] ;
  sx:shapeExprs ((@<#shapeDeclOrExpr>))[2, *]
}

<#ShapeNot> CLOSED {
  a [sx:ShapeNot] ;
  sx:shapeExpr @<#shapeDeclOrExpr>
}

# RDF-: ((shapeExpr))[min, max], a sequence of min to max elements each conforming to shapeExpr
<#Collection> CLOSED {
  a [sx:Collection] ;
  sx:shapeExpr @<#shapeDeclOrExpr> ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ?
}

<#NodeConstraint> CLOSED {
  a [sx:NodeConstraint] ;
  sx:nodeKind [sx:iri sx:bnode sx:literal sx:nonliteral] ? ;
  sx:datatype IRI ? ;
  &<#xsFacets> ;
  sx:values ((@<#valueSetValue>))[1, *] ? ;
  sx:semActs ((@<#SemAct>))[1, *] ? ;
  sx:annotation ((@<#Annotation>))[1, *] ?
}

<#Shape> CLOSED {
  a [sx:Shape] ;
  sx:extends ((@<#shapeDeclOrExpr>))[1, *] ? ;
  sx:closed [true false] ? ;
  sx:extra IRI * ;
  sx:expression @<#tripleExpression> ? ;
  sx:semActs ((@<#SemAct>))[1, *] ? ;
  sx:annotation ((@<#Annotation>))[1, *] ?
}

<#ShapeExternal> CLOSED {
  a [sx:ShapeExternal]
}

<#SemAct> CLOSED {
  a [sx:SemAct] ;
  sx:name IRI ;
  sx:code xsd:string ?
}

<#Annotation> CLOSED {
  a [sx:Annotation] ;
  sx:predicate IRI ;
  sx:object @<#objectValue>
}

<#facet_holder> { # hold labeled productions
  $<#xsFacets> ( &<#stringFacet> | &<#numericFacet> ) * ;
  $<#stringFacet> (
      sx:length xsd:integer
    | sx:minlength xsd:integer
    | sx:maxlength xsd:integer
    | sx:pattern xsd:string ; sx:flags xsd:string ?
  ) ;
  $<#numericFacet> (
      sx:mininclusive   @<#numericLiteral>
    | sx:minexclusive   @<#numericLiteral>
    | sx:maxinclusive   @<#numericLiteral>
    | sx:maxexclusive   @<#numericLiteral>
    | sx:totaldigits    xsd:integer
    | sx:fractiondigits xsd:integer
  )
}
<#numericLiteral> xsd:integer OR xsd:decimal OR xsd:double

<#valueSetValue> @<#objectValue> OR @<#IriStem> OR @<#IriStemRange>
                               OR @<#LiteralStem> OR @<#LiteralStemRange>
                OR @<#Language> OR @<#LanguageStem> OR @<#LanguageStemRange>
<#objectValue> IRI OR LITERAL OR ((@<#objectValue>)) # rdf:langString breaks on Annotation.object # RDF-: or a sequence of them

<#IriStem> CLOSED { a [sx:IriStem] ; sx:stem xsd:string }
<#IriStemRange> CLOSED {
  a [sx:IriStemRange] ;
  sx:stem xsd:string OR @<#Wildcard> ;
  sx:exclusion ((IRI OR @<#IriStem>))[1, *]
}

<#LiteralStem> CLOSED { a [sx:LiteralStem] ; sx:stem xsd:string }
<#LiteralStemRange> CLOSED {
  a [sx:LiteralStemRange] ;
  sx:stem xsd:string OR @<#Wildcard> ;
  sx:exclusion ((xsd:string OR @<#LiteralStem>))[1, *]
}

<#Language> CLOSED { a [sx:Language] ; sx:languageTag xsd:string }
<#LanguageStem> CLOSED { a [sx:LanguageStem] ; sx:stem xsd:string }
<#LanguageStemRange> CLOSED {
  a [sx:LanguageStemRange] ;
  sx:stem xsd:string OR @<#Wildcard> ;
  sx:exclusion ((xsd:string OR @<#LanguageStem>))[1, *]
}

<#Wildcard> BNODE CLOSED {
  a [sx:Wildcard]
}

<#tripleExpression>
     @<#NotYetResolvedInclusion>
  OR @<#TripleConstraint>
  OR @<#OneOf>
  OR @<#EachOf>

<#NotYetResolvedInclusion> CLOSED {} # will have 1 incoming, 0 outgoing arcs

<#OneOf> CLOSED {
  a [sx:OneOf] ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ? ;
  sx:expressions ((@<#tripleExpression>))[2, *] ;
  sx:semActs ((@<#SemAct>))[1, *] ? ;
  sx:annotation ((@<#Annotation>))[1, *] ?
}

<#EachOf> CLOSED {
  a [sx:EachOf] ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ? ;
  sx:expressions ((@<#tripleExpression>))[2, *] ;
  sx:semActs ((@<#SemAct>))[1, *] ? ;
  sx:annotation ((@<#Annotation>))[1, *] ?
}

<#TripleConstraint> CLOSED {
  a [sx:TripleConstraint] ;
  sx:inverse [true false] ? ;
  sx:min xsd:integer ? ;
  sx:max xsd:integer ? ;
  sx:predicate IRI ;
  sx:valueExpr @<#shapeDeclOrExpr> ? ;
  sx:semActs ((@<#SemAct>))[1, *] ? ;
  sx:annotation ((@<#Annotation>))[1, *] ?
}

# RDF-: there are no RDF lists.  A list written `( ... )` is one sequence term,
# matched above by the Collection shape expressions ((@<#X>))[1, *] in place of
# the ListNPlus ladder shapes of shexTest's ShExR.shex.
